# Copie a .env para personalizar. En docker-compose.yml todos tienen un valor de demostración local.
# NUNCA reutilice estos valores en un entorno público.

# Contraseña de 'sa' de SQL Server (mín. 8 caracteres con mayúscula, minúscula, número y símbolo).
MSSQL_SA_PASSWORD=Pr0ntoReclamo2026!

# Clave del header X-Api-Key (acceso programático a /api/admin).
ADMIN_API_KEY=admin-secret-key-2026

# Inicio de sesión del panel /admin (genera un JWT).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-pass-2026

# Secreto con el que se firma el JWT. Mínimo 32 caracteres; genere uno aleatorio en cualquier entorno público.
JWT_SIGNING_KEY=demo-local-signing-key-cambiar-0123456789abcdef
